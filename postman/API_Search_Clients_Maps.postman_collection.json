						"method": "GET",
						"header": [
							{
								"key": "Accept",
								"value": "application/json"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/api/places/scrape",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"places",
								"scrape"
							]
						},
						"description": "Busca restaurantes, barbearias, clínicas, mercadinhos e outros locais perto das coordenadas padrão do `application.properties`. Retorna apenas estabelecimentos **com site**, salva no banco e imprime no console do servidor."
					},
					"response": []
				},
				{
					"name": "Buscar e salvar estabelecimentos (coordenadas customizadas)",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Accept",
								"value": "application/json"
							}
