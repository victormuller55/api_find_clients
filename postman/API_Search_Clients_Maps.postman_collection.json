							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"places",
								"scrape"
							],
							"query": [
								{
									"key": "latitude",
									"value": "{{latitude}}",
									"description": "Latitude (ex: -23.5505)"
								},
								{
									"key": "longitude",
									"value": "{{longitude}}",
									"description": "Longitude (ex: -46.6333)"
								},
								{
									"key": "radiusMeters",
									"value": "{{radiusMeters}}",
									"description": "Raio da busca em metros (ex: 5000)"
								},
								{
									"key": "location",
									"value": "{{location}}",
									"description": "Texto da região (ex: São Paulo, SP)"
								}
							]
						},
						"description": "Mesma busca do scrape, mas com latitude, longitude e raio informados na query string."
					},
					"response": []
				},
				{
